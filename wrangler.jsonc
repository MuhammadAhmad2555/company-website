{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "company-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "arcx9.com",
      "custom_domain": true
    }
  ]
}
